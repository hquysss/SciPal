{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@scipal/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-local-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@scipal/web",
        "dev"
      ],
      "env": {
        "NEXT_PUBLIC_API_BASE_URL": "http://localhost:3001"
      },
      "port": 3000
    },
    {
      "name": "web-local-api-3021",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@scipal/web",
        "dev",
        "--port",
        "3021"
      ],
      "env": {
        "NEXT_PUBLIC_API_BASE_URL": "http://localhost:3001"
      },
      "port": 3021
    },
    {
      "name": "web-3020",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@scipal/web",
        "dev",
        "--port",
        "3020"
      ],
      "port": 3020
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@scipal/api",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web-skin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "D:/Code/SciPal-skin/frontend",
        "exec",
        "next",
        "dev",
        "-p",
        "3005"
      ],
      "port": 3005
    }
  ]
}